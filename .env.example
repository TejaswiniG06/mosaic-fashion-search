# ---------------------------------------------------------------- MOSAIC-Fashion configuration
# Copy to .env and adjust. Everything is free/open-source; no paid API is required.
ENV=dev
LOG_LEVEL=INFO
LOG_JSON=true

# Service URLs (docker-compose overrides these with service DNS names)
GATEWAY_URL=http://localhost:8000
INTENT_URL=http://localhost:8001
EMBEDDING_URL=http://localhost:8002
RETRIEVAL_URL=http://localhost:8003
RANKING_URL=http://localhost:8004
CATALOGUE_URL=http://localhost:8005
INDEXER_URL=http://localhost:8006

# Infrastructure
# Catalogue database: postgres (production) or sqlite (zero-install laptop mode; file at SQLITE_PATH)
CATALOGUE_DB=postgres
# SQLITE_PATH=./data/catalogue.db
POSTGRES_DSN=postgresql://mosaic:mosaic_dev_pw@localhost:5432/mosaic
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=products
# QDRANT_API_KEY=

# Models (downloaded by scripts/download_models.sh)
TEXT_MODEL_DIR=./models/multilingual-e5-small
TEXT_MODEL_FILE=model_int8.onnx
CLIP_MODEL_DIR=./models/clip-vit-b32
IMAGE_ROOT=./data/images
ONNX_THREADS=2

# ---------------------------------------------------------------- LLM (optional, FREE options)
# none          -> deterministic multilingual rule engine only (default, zero cost, fully offline)
# openai_compat -> any OpenAI-compatible endpoint. Free choices:
#                    Groq free tier:   LLM_BASE_URL=https://api.groq.com/openai/v1   LLM_MODEL=llama-3.1-8b-instant
#                    OpenRouter free:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
# gemini        -> Google AI Studio free tier: LLM_MODEL=gemini-2.0-flash  (LLM_API_KEY = AI Studio key)
# ollama        -> local & free: LLM_BASE_URL=http://localhost:11434 LLM_MODEL=qwen2.5:3b
LLM_PROVIDER=none
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
LLM_TIMEOUT_S=6
LLM_EXPLANATIONS=false

# Retrieval / ranking
CANDIDATE_POOL=100
RRF_K=60
SEARCH_CACHE_TTL_S=300

# Gateway per-IP rate limit (token bucket). Set 0 to disable for load tests / offline evaluation.
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Security (change in any shared deployment)
ADMIN_API_KEY=change-me-admin-key
