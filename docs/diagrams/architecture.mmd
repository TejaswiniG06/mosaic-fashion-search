flowchart TB
  USER["Shopper / Streamlit UI<br/>Multilingual text + optional image"] --> GW["Gateway :8000<br/>Calls each service, caches responses<br/>Timeouts and degraded-mode fallbacks"]
  GW --> SEARCH
  subgraph SEARCH["Search data flow — gateway orchestrates each step"]
    direction LR
    IN["1. Intent<br/>Rules + validated LLM<br/>Hard constraints and context"] --> EM["2. Embedding<br/>e5 + CLIP vectors<br/>Restricted image loading"]
    EM --> RT["3. Retrieval<br/>BM25 + Qdrant / RRF<br/>Filter candidates"]
    RT --> RK["4. Ranking<br/>Context-adaptive signals<br/>Approved explanations"]
  end
  SEARCH --> OUT["Catalogue results<br/>Scores, explanations, timings and degraded flags"]
  SEARCH -. "intent / ranking only" .-> LLM["Optional LLM<br/>Untrusted output"]
  SEARCH <-->|"retrieval reads vectors"| QD[("Qdrant")]
  subgraph CATALOGUE["Asynchronous catalogue updates"]
    direction LR
    ADMIN["Admin / feed"] -->|"admin key"| CAT["Catalogue :8005"]
    CAT --> PG[("PostgreSQL<br/>Products + outbox")]
    PG -->|"relay"| RS[("Redis Streams")]
    RS --> IDX["Indexer :8006<br/>Embed, upsert / delete"]
  end
  CATALOGUE -->|"incremental vector updates"| QD
  CATALOGUE -->|"events update BM25 / indexer calls embedding"| SEARCH
  classDef service fill:#eff6ff,stroke:#2563eb,color:#172554;
  classDef storage fill:#f1f5f9,stroke:#64748b,color:#0f172a;
  classDef boundary fill:#fff7ed,stroke:#c2410c,color:#7c2d12;
  class IN,EM,RT,RK,GW,CAT,IDX service;
  class PG,RS,QD storage;
  class LLM,ADMIN boundary;
